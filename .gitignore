# ROMs and game data — NEVER commit. Definition of done: "No ROM files in git."
*.gba
*.nds
*.sav
*.srm
*.st[0-9]
*.state

# Patches and settings are only committed when we authored them.
/drop/

# Build
.gradle/
build/
local.properties
*.apk
*.aab
captures/

# IDE
.idea/
*.iml
.DS_Store
# Added by code-review-graph
.code-review-graph/

# Gradle
.gradle/
build/
local.properties

# vendoring working copies (the vendored source itself IS committed)
.vendor/

# native build intermediates
.cxx/
libretrodroid/build/

# Release artefacts are attached to GitHub releases, not committed.
dist/

# Signing keys never go in a repo (master is archived into the public KaizoCore repo; rc33 audit P1 #3).
*.keystore
*.jks
*.p12

# Python caches: the release gate refuses untracked files (tools/release_checks.py)
__pycache__/
*.pyc
